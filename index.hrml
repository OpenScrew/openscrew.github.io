```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>OpenScrew Foundation — Work in Progress</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {
            background: #ffffff;
            color: #0a0a0a;

            font-family:
                "Helvetica Neue",
                Helvetica,
                Arial,
                sans-serif;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;
        }

        .page {
            width: 100%;
            height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;
        }

        .title {
            width: 82vw;

            font-size: clamp(70px, 13vw, 210px);
            line-height: 0.82;

            font-weight: 800;
            letter-spacing: -0.075em;

            text-align: center;
            text-transform: uppercase;

            user-select: none;
        }

        .title span {
            display: block;
        }

        .title .second {
            margin-left: 4vw;
        }

        /* Small understated identity */

        .brand {
            position: absolute;

            top: 30px;
            left: 35px;

            font-size: 12px;
            font-weight: 600;

            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .year {
            position: absolute;

            bottom: 30px;
            right: 35px;

            font-size: 11px;
            font-weight: 500;

            letter-spacing: 0.12em;

            color: #777;
        }

        /* Subtle entrance */

        .title {
            animation: appear 0.9s cubic-bezier(.16,1,.3,1) both;
        }

        @keyframes appear {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 700px) {

            .title {
                width: 92vw;

                font-size: clamp(52px, 15vw, 110px);
                line-height: 0.85;

                letter-spacing: -0.07em;
            }

            .title .second {
                margin-left: 0;
            }

            .brand {
                top: 22px;
                left: 22px;

                font-size: 10px;
            }

            .year {
                bottom: 22px;
                right: 22px;

                font-size: 9px;
            }
        }
    </style>
</head>

<body>

    <div class="page">

        <div class="brand">
            OpenScrew
        </div>

        <h1 class="title">
            <span>Work In</span>
            <span class="second">Progress</span>
        </h1>

        <div class="year">
            2026
        </div>

    </div>

    <script>
        // Very subtle mouse movement for the typography.
        // Remove this block if you want completely static text.

        const title = document.querySelector(".title");

        window.addEventListener("mousemove", (event) => {

            const x =
                (event.clientX / window.innerWidth - 0.5) * 4;

            const y =
                (event.clientY / window.innerHeight - 0.5) * 4;

            title.style.transform =
                `translate(${x}px, ${y}px)`;
        });
    </script>

</body>
</html>
```
